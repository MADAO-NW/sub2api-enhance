# 示例值，不包含真实环境凭据。复制到源码目录外后填写。
ENHANCE_LISTEN=127.0.0.1:18081
ENHANCE_DATABASE_URL=postgres://enhance_user:REPLACE_ME@127.0.0.1:5432/sub2api?sslmode=disable
SUB2API_INTERNAL_URL=http://127.0.0.1:18080
ENHANCE_PUBLIC_ORIGIN=https://gateway.example.com
SUB2API_ADMIN_API_KEY=REPLACE_ME
# 填入 32 字节随机密钥的 Base64；不要复用原项目 TOTP/JWT 密钥。
ENHANCE_ENCRYPTION_KEY=REPLACE_ME
# 示例容量，部署前按连接预算调整；采集池和后台池独立。
ENHANCE_DB_CONNECTIONS=8
ENHANCE_INGRESS_CONNECTIONS=8
# 与真实 Nginx 地址相符时才使用本例；不可信客户端不能直达监听端口。
ENHANCE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 只有启用通知才填写 SMTP；465 使用隐式 TLS，其他端口使用 STARTTLS。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 结转和缓存修复需要 HGETALL、DEL、SREM；为空时只做数据库复核，不能结转。
# 示例格式 redis://enhance_quota:REPLACE_ME@127.0.0.1:6379/15
QUOTA_FOLLOW_REDIS_URL=
# 必须填写原版实际使用的 IANA 时区。为空或无效时阻断结转，窗口变化保留待归因。
SUB2API_TIMEZONE=Asia/Shanghai

# 必须核实原版实际 database.user_platform_quota_flusher_enabled；为空或 true 时禁止结转和缓存清理。
# 原版配置确为关闭时填 false，本变量不会修改原版配置。
SUB2API_USER_PLATFORM_QUOTA_FLUSHER_ENABLED=

# 可选：仅增强仓库发布检查/下载使用；私有仓库或 API 限流时注入，不复用原版管理员 Key。
UPDATE_GITHUB_TOKEN=
